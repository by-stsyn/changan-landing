# ==============================================================================
# .htaccess для https://sale.pragmatika-changanauto.ru/ (Хостинг Reg.ru / Apache)
# ==============================================================================

# Кодировка по умолчанию UTF-8
AddDefaultCharset UTF-8

# Запрет листинга каталогов
Options -Indexes +FollowSymLinks

# ------------------------------------------------------------------------------
# 1. MIME-типы современных веб-форматов
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg .svgz
  AddEncoding gzip .svgz
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType application/json .json
  AddType text/xml .xml
</IfModule>

# ------------------------------------------------------------------------------
# 2. GZIP / DEFLATE сжатие (ускорение загрузки в 3-5 раз)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 3. Кэширование статических ресурсов в браузере (Browser Caching)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML и proxy.php — не кэшировать жестко, чтобы обновления и цены были актуальными
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 15 minutes"

  # Картинки и шрифты — кэшировать на 1 год
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # CSS и JS (в Vite они имеют уникальные хэши в имени файла)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 4. Безопасность и защита системных файлов
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Защита от MIME-sniffing
  Header set X-Content-Type-Options "nosniff"
  # Защита от clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Реферер
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Не кэшировать index.html жестко
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# Блокировка доступа к служебным файлам и репозиториям
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

<FilesMatch "(package\.json|package-lock\.json|tsconfig.*|\.env.*|\.git.*|\.sql)$">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------------------------
# 5. Маршрутизация React SPA (Роутинг для прямых ссылок /car/:vin)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Безопасный редирект на HTTPS (учитывает Nginx прокси Reg.ru)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Если запрашивается реальный существующий файл или папка — отдаем его напрямую
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Специальное исключение: скрипт фида proxy.php выполняется напрямую
  RewriteRule ^proxy\.php$ proxy.php [L]

  # Все остальные запросы (например, /car/LS4ASE2EXRA272343) перенаправлять в index.html
  RewriteRule ^ index.html [L]
</IfModule>
